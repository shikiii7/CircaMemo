:38790.75184051801,"shape_area":52153372.525592625,"district":"未央区","time_start":-221,"time_end":-206},"geometry":{"type":"MultiPolygon","coordinates":[[[[108.785115075,34.410079328],[108.804751974,34.415196673],[108.805100398,34.42010632],[108.816069523,34.422031697],[108.816286621,34.42369531],[108.824546421,34.425887732],[108.825607316,34.421384913],[108.832158477,34.423505092],[108.826939048,34.434196865],[108.841956181,34.438756541],[108.843890411,34.431250465],[108.864338604,34.436269303],[108.860015188,34.455614348],[108.881875546,34.460453731],[108.88636168,34.4379432],[108.892712878,34.439895049],[108.89127232,34.427251204],[108.903260842,34.411595043],[108.905300197,34.405086267],[108.897165322,34.40542797],[108.887272938,34.400556194],[108.882927022,34.400274606],[108.867817753,34.393722477],[108.852631977,34.39207094],[108.848119116,34.390716972],[108.844022584,34.38600319],[108.841049329,34.384318633],[108.84080807,34.379471613],[108.83904647,34.376819591],[108.833514968,34.376324569],[108.829133203,34.376713707],[108.825433111,34.379519985],[108.820291802,34.37785254],[108.815385876,34.375594185],[108.808387158,34.369513136],[108.805780832,34.372460858],[108.802606169,34.376477902],[108.797434544,34.38002835],[108.794360557,34.381167274],[108.785115075,34.410079328]]]]}},{"type":"Feature","properties":{"objectid":5,"name":"秦栎阳城","period":"秦","intro":"战国秦都遗址，位于今西安市阎良区。秦献公二年（前383年）迁都于此，秦孝公时商鞅在此推行变法，奠定秦国强盛基础。栎阳为秦都约35年，是秦由弱转强之地。考古发现城垣及宫殿基址，为全国重点文物保护单位。","shape_length":21564.273357207192,"shape_area":25582743.275926236,"district":"阎良区","time_start":-221,"time_end":-206},"geometry":{"type":"MultiPolygon","coordinates":[[[[109.264772524,34.683026904],[109.271594094,34.682050211],[109.280318011,34.678975365],[109.282243831,34.67661494],[109.288378588,34.677030333],[109.28982337,34.679917407],[109.302659667,34.678421088],[109.308198586,34.671064972],[109.313502243,34.669780436],[109.314671078,34.670620264],[109.320551736,34.669295101],[109.324157967,34.66250475],[109.331479569,34.658435638],[109.335746473,34.654331404],[109.334427949,34.649299467],[109.337591623,34.643331896],[109.334337296,34.638491653],[109.272858215,34.63246578],[109.264772524,34.683026904]]]]}},{"type":"Feature","properties":{"objectid":6,"name":"西周镐京","period":"西周","intro":"西周都城遗址，位于今西安市西南沣河东岸。武王灭商后建都于此，与沣河西岸丰京合称\"丰镐\"，为西周政治文化中心，建有宗庙、辟雍。丰镐遗址对研究西周文明意义重大，为全国重点文物保护单位。","shape_length":12295.483268669388,"shape_area":8843692.393570958,"district":"长安区","time_start":-1046,"time_end":-771},"geometry":{"type":"MultiPolygon","coordinates":[[[[108.741453669,34.240618327],[108.770837076,34.240437111],[108.76806193,34.23864288],[108.7677281,34.237206308],[108.769643967,34.236235189],[108.773612157,34.235197826],[108.773858967,34.213083466],[108.741021764,34.213286254],[108.741453669,34.240618327]]]]}},{"type":"Feature","properties":{"objectid":7,"name":"西周丰京","period":"西周","intro":"西周早期都城遗址，位于今西安市西南沣河西岸。周文王自岐山东迁至此，是周人东进灭商的策源地。武王灭商后在河东建镐京，二京隔河相望合称\"丰镐\"，丰京为宗庙祭祀重地。为全国重点文物保护单位。","shape_length":15352.861033003655,"shape_area":13640967.623475002,"district":"长安区","time_start":-1046,"time_end":-771},"geometry":{"type":"MultiPolygon","coordinates":[[[[108.691075086,34.215442796],[108.728983544,34.215596329],[108.72980309,34.213939646],[108.729155761,34.213250803],[108.725861543,34.210552848],[108.725837333,34.207728929],[108.725446609,34.207038546],[108.725424242,34.20442775],[108.731594115,34.198529841],[108.733307023,34.196388243],[108.733176991,34.181362834],[108.690992283,34.18171421],[108.691075086,34.215442796]]]]}},{"type":"Feature","properties":{"objectid":8,"name":"秦阿房宫遗址","period":"秦","intro":"秦代宫殿遗址，位于今西安市西郊。始皇三十五年（前212年）始建，前殿规模空前。杜牧《阿房宫赋》使之千古闻名，但考古证实阿房宫并未建成，项羽所焚实为咸阳宫。1961年列全国重点文物保护单位。","shape_length":11115.421837430215,"shape_area":3641931.596943254,"district":"长安区","time_start":-221,"time_end":-206},"geometry":{"type":"MultiPolygon","coordinates":[[[[108.797585423,34.269171249],[108.816601642,34.268977816],[108.816452511,34.270547468],[108.824995844,34.270490255],[108.825001397,34.262646923],[108.818020506,34.262796016],[108.817831142,34.260205579],[108.829616506,34.259989972],[108.830180745,34.25889491],[108.833712251,34.258836839],[108.833683994,34.255972522],[108.802680562,34.256384071],[108.802674798,34.260101161],[108.797623005,34.260100038],[108.797585423,34.269171249]]]]}},{"type":"Feature","properties":{"objectid":9,"name":"西汉建章宫遗址","period":"西汉","intro":"西汉皇家宫殿遗址，位于汉长安城西墙外。武帝太初元年（前104年）建，号称\"千门万户\"。太液池中筑蓬莱等仙山，体现汉代神仙信仰。与未央宫隔墙相对，武帝晚年常居于此。为全国重点文物保护单位。","shape_length":4440.5587518592765,"shape_area":973538.0346491804,"district":"未央区","time_start":-206,"time_end":8},"geometry":{"type":"MultiPolygon","coordinates":[[[[108.821869595,34.31425076],[108.830364524,34.314171638],[108.83039048,34.311465206],[108.833231079,34.311467741],[108.833201115,34.311096925],[108.836304048,34.311032129],[108.836307961,34.306121556],[108.830153754,34.306119768],[108.830131967,34.306578235],[108.821900147,34.306590095],[108.821869595,34.31425076]]]]}},{"type":"Feature","properties":{"objectid":10,"name":"隋大兴唐长安城","period":"唐","intro":"隋唐都城遗址，中国古代规模最大的都城。隋开皇二年（582年）建大兴城，唐改名长安城，面积约84平方公里，人口逾百万。朱雀大街为中轴，108坊整齐排列。其规划影响日本平城京等，2014年列入世界文化遗产。","shape_length":43230.43039204157,"shape_area":88835695.04480593,"district":"雁塔区","time_start":618,"time_end":907},"geometry":{"type":"MultiPolygon","coordinates":[[[[108.949647023,34.291772435],[108.949915749,34.304238415],[108.965962919,34.303846512],[108.966027874,34.298304651],[108.968305929,34.289814788],[108.974598363,34.289924741],[108.974493803,34.280867585],[108.987011295,34.280927241],[108.987042076,34.200237967],[108.98277415,34.200272234],[108.983002049,34.195155241],[108.97171888,34.195381539],[108.97142351,34.205409612],[108.882304345,34.205744144],[108.882876506,34.282682511],[108.930406987,34.282112578],[108.930495334,34.287742636],[108.944027584,34.287517478],[108.944082181,34.291807174],[108.949647023,34.291772435]]]]}},{"type":"Feature","properties":{"objectid":11,"name":"杜陵遗址","period":"汉","intro":"西汉宣帝刘询陵墓，位于今西安市东南杜陵原。宣帝为西汉中兴之主，在位时政治清明、四夷宾服。封土高约30米，为西汉帝陵规模较大者。陪葬坑出土大量陶俑、金银器，1988年列全国重点文物保护单位。","shape_length":17010.47342720485,"shape_area":9144118.783646666,"district":"长安区","time_start":-206,"time_end":220},"geometry":{"type":"MultiPolygon","coordinates":[[[[109.007976204,34.198115453],[109.018015956,34.201122945],[109.02141375,34.201041417],[109.0222025,34.202633328],[109.025919669,34.202442447],[109.026275762,34.204403981],[109.02780961,34.204930911],[109.027790209,34.203332593],[109.031829953,34.203298677],[109.032510618,34.201268209],[109.030386835,34.200646676],[109.029696091,34.197497928],[109.034450872,34.197362229],[109.036421588,34.195960246],[109.043782811,34.184495341],[109.048734137,34.170120059],[109.011805475,34.169737414],[109.005244112,34.167819862],[109.004076752,34.172092065],[109.011191184,34.171980364],[109.010571782,34.173797089],[109.010283064,34.181845197],[109.018652831,34.184759838],[109.020265922,34.196255522],[109.008852298,34.196296634],[109.007976204,34.198115453]]]]}},{"type":"Feature","properties":{"objectid":12,"name":"霸陵遗址","period":"汉","intro":"西汉文帝刘恒陵墓，位于今西安市东郊白鹿原。文帝开创\"文景之治\"，以节俭著称。霸陵是中国第一座依山为陵的帝陵，开创崖洞墓先例。2021年考古确认江村大墓即霸陵，为全国重点文物保护单位。","shape_length":10987.000900927833,"shape_area":6924653.395759381,"district":"灞桥区","time_start":-206,"time_end":220},"geometry":{"type":"MultiPolygon","coordinates":[[[[109.093880548,34.23536388],[109.106740217,34.258471724],[109.109370461,34.258569215],[109.110709494,34.260436772],[109.119206214,34.256842653],[109.129831737,34.25413787],[109.1167565,34.226183641],[109.112965002,34.226521289],[109.107485188,34.231724903],[109.101240757,34.234327828],[109.093880548,34.23536388]]]]}},{"type":"Feature","properties":{"objectid":13,"name":"秦始皇陵","period":"秦","intro":"中国第一位皇帝嬴政的陵墓，位于今西安市临潼区。前247年始建，历时39年，为历代帝陵规模最大者。1974年发现兵马俑被誉为\"世界第八大奇迹\"，出土陶俑陶马近八千件。1987年列入世界文化遗产。","shape_length":22416.894917609116,"shape_area":25998289.311506227,"district":"临潼区","time_start":-221,"time_end":-206},"geometry":{"type":"MultiPolygon","coordinates":[[[[109.23746814,34.406937233],[109.251043508,34.409942324],[109.255816298,34.412881376],[109.259042735,34.415719751],[109.263302434,34.415637022],[109.265093206,34.413290232],[109.279806272,34.407859737],[109.284239103,34.403816402],[109.283938074,34.374910068],[109.278778433,34.374149195],[109.273878485,34.371988425],[109.269337307,34.368776003],[109.26661713,34.365272939],[109.266302238,34.353673512],[109.265038112,34.350504571],[109.258936407,34.3492093],[109.255749623,34.348853982],[109.250648378,34.348750985],[109.245542824,34.357844633],[109.243643801,34.362326528],[109.243130332,34.366037254],[109.243381857,34.36993498],[109.237522684,34.369295878],[109.233386314,34.368057067],[109.229454795,34.368019017],[109.229681343,34.38031795],[109.23356721,34.380395253],[109.232931957,34.381759831],[109.228123326,34.385805107],[109.225350363,34.388238821],[109.225391075,34.391032374],[109.232370663,34.397753132],[109.236313836,34.401671444],[109.237481812,34.404686413],[109.23746814,34.406937233]]]]}},{"type":"Feature","properties":{"objectid":14,"name":"姜寨遗址","period":"新石器时代","intro":"新石器时代仰韶文化聚落遗址，位于今西安市临潼区。距今约6700年，发现完整环壕聚落，中心为广场，周围分布房屋百余座，是研究仰韶社会组织的珍贵标本。出土彩陶及中国最早黄铜片，为全国重点文物保护单位。","shape_length":3458.873877187243,"shape_area":558568.8892276555,"district":"临潼区","time_start":-10000,"time_end":-2070},"geometry":{"type":"MultiPolygon","coordinates":[[[[109.202604575,34.374596224],[109.20252666,34.379874],[109.208084976,34.379787461],[109.208143858,34.381217393],[109.211498566,34.381200118],[109.21134471,34.374510018],[109.208871947,34.374518577],[109.208869877,34.373040399],[109.206530182,34.372968122],[109.206458962,34.374685442],[109.202604575,34.374596224]]]]}},{"type":"Feature","properties":{"objectid":15,"name":"杨官寨遗址","period":"新石器时代","intro":"新石器时代庙底沟文化聚落遗址，位于今西安市高陵区。距今约5500年，面积约80万平方米，为关中同期最大遗址。发现环壕、制陶作坊及大量彩陶玉器，对探索文明起源意义重大。2018年入选全国十大考古新发现。","shape_length":7692.576581786827,"shape_area":2654966.4863991113,"district":"高陵区","time_start":-10000,"time_end":-2070},"geometry":{"type":"MultiPolygon","coordinates":[[[[109.005461206,34.503284481],[109.010477158,34.503320707],[109.010768211,34.504133211],[109.018501709,34.504068981],[109.018511149,34.504845008],[109.031494594,34.504774878],[109.031436312,34.49623821],[109.02623619,34.496437222],[109.025153064,34.496019456],[109.022879849,34.494098242],[109.01177447,34.494307125],[109.011733694,34.490931393],[109.006484639,34.490935938],[109.006250764,34.498776558],[109.005500895,34.498782731],[109.005461206,34.503284481]]]]}},{"type":"Feature","properties":{"objectid":16,"name":"大明宫遗址","period":"唐","intro":"唐三大内之一，称\"东内\"，位于长安城东北龙首塬上。贞观八年（634年）始建，自高宗起为政治中心二百余年。面积约3.2平方公里，含元殿、宣政殿为中轴。1961年列全国重点文保，2014年列入世界文化遗产。","shape_length":7898.207036006497,"shape_area":3569897.4153584256,"district":"新城区","time_start":618,"time_end":907},"geometry":{"type":"MultiPolygon","coordinates":[[[[108.951666329,34.282550781],[108.951190626,34.294296966],[108.950788801,34.304217148],[108.950749108,34.305196995],[108.966241431,34.305776978],[108.966381916,34.296985314],[108.966402209,34.295715325],[108.966613054,34.282519644],[108.965398058,34.282522243],[108.951666329,34.282550781]]]]}}]}
