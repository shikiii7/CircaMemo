{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/data/memory-albums/schema.v1.json",
  "title": "CircaMemo memory album schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "albumId",
    "contentVersion",
    "status",
    "locale",
    "createdAt",
    "binding",
    "title",
    "subtitle",
    "summary",
    "coverImageId",
    "editorialNotes",
    "pages",
    "timeline",
    "sources",
    "images"
  ],
  "properties": {
    "$schema": {
      "const": "/data/memory-albums/schema.v1.json"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "albumId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": ["draft", "static-content-ready"]
    },
    "locale": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date"
    },
    "binding": {
      "$ref": "#/$defs/binding"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "coverImageId": {
      "type": "string",
      "minLength": 1
    },
    "editorialNotes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timelineEvent"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/articleSource"
      }
    },
    "images": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/image"
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryPid", "primaryName", "related"],
      "properties": {
        "primaryPid": {
          "type": "string",
          "pattern": "^P[0-9]+$"
        },
        "primaryName": {
          "type": "string",
          "minLength": 1
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pid", "name", "relationship", "duplicateAlbum"],
            "properties": {
              "pid": {
                "type": "string",
                "pattern": "^P[0-9]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "relationship": {
                "type": "string",
                "minLength": 1
              },
              "duplicateAlbum": {
                "const": false
              }
            }
          }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "order", "eyebrow", "title", "blocks", "imageIds", "sourceIds"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["cover", "feature", "timeline", "credits"]
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "eyebrow": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "text"],
            "properties": {
              "kind": {
                "enum": ["lead", "paragraph", "fact", "note"]
              },
              "heading": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "imageIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "timelineEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "date", "dateLabel", "title", "text", "sourceIds"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "minLength": 4
        },
        "dateLabel": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "articleSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "publisher",
        "publicationDate",
        "dateNote",
        "authors",
        "url",
        "usage",
        "textUseNote"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^art_[0-9]{4}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "publicationDate": {
          "type": ["string", "null"]
        },
        "dateNote": {
          "type": ["string", "null"]
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "usage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "textUseNote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceAssetId",
        "path",
        "mimeType",
        "width",
        "height",
        "bytes",
        "sha256",
        "dateLabel",
        "alt",
        "caption",
        "creator",
        "sourceUrl",
        "attribution",
        "changes",
        "source",
        "safety"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sourceAssetId": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^/images/memory-albums/"
        },
        "mimeType": {
          "const": "image/webp"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dateLabel": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "creator": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "licenseUrl": {
          "type": ["string", "null"]
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mimeType", "width", "height", "bytes", "sha256"],
          "properties": {
            "mimeType": {
              "type": "string",
              "minLength": 1
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewed", "recognizableMinors", "notes"],
          "properties": {
            "reviewed": {
              "const": true
            },
            "recognizableMinors": {
              "type": "boolean"
            },
            "notes": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
