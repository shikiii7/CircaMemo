    {"id":"e","name":"西风照晚","avatar":"/avatars/chat/mountain-dawn.svg","side":"left"},
    {"id":"f","name":"跑过丹凤门","avatar":"/avatars/chat/bird-sky.svg","side":"right"},
    {"id":"g","name":"一杯茯茶","avatar":"/avatars/chat/coffee-book.svg","side":"left"},
    {"id":"h","name":"花树下","avatar":"/avatars/chat/peony.svg","side":"right"},
    {"id":"i","name":"北城旧影","avatar":"/avatars/chat/lake-night.svg","side":"left"},
